# ==============================================================================
# Luna Pipeline .gitignore
# Prevents large media binaries, archives, and temporary artifacts from bloating Git
# ==============================================================================

# OS & Environment
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Video Exports (>100MB violates GitHub hard limits)
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv

# Audio Binaries (Intermediate & generated voiceovers)
*.wav
*.mp3
*.aac
*.flac
*.m4a

# Large Archives & Media Zips
*.zip
*.tar
*.gz
*.rar
*.7z

# Intermediate image extraction folders in projects
**/sequenced_images/
**/generated_images/

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.tmp
.pytest_cache/
venv/
.venv/
env/

# Node.js & MCP Server
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local

# IDE & Editor Scratch Files
.vscode/
.idea/
*.swp
*.swo
